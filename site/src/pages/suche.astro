---
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL;
---
<Base title="Suche" description="Volltextsuche über alle Orgeln, Personen und Literaturnachweise.">
  <h1>Suche</h1>
  <p>Durchsucht Orgel-, Personen- und Literaturseiten gleichzeitig.</p>
  <div id="search" data-base={base}></div>
</Base>

<link rel="stylesheet" href={`${base}/pagefind/pagefind-ui.css`} />
<script is:inline type="module">
  // Pagefind's index is generated post-build (see package.json "postbuild"),
  // so it only exists after `npm run build`, not in `astro dev` - that's
  // expected, this page will 404 on the JS import during local dev.
  // is:inline + type=module: Astro's define:vars wraps the script in a plain
  // function, where the top-level `await import` is a syntax error.
  const el = document.getElementById("search");
  const base = el.dataset.base;
  const { PagefindUI } = await import(`${base}/pagefind/pagefind-ui.js`);
  const ui = new PagefindUI({ element: "#search", showSubResults: true, showImages: false });
  // Suchfeld der Startseite übergibt ?q=...
  const q = new URLSearchParams(location.search).get("q");
  if (q) ui.triggerSearch(q);
</script>
