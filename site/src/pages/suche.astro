---
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL;
---
<Base title="Suche" description="Volltextsuche über alle Orgeln, Personen und Literaturnachweise.">
  <h1>Suche</h1>
  <p>Durchsucht Orgel-, Personen- und Literaturseiten gleichzeitig.</p>
  <div id="search" data-base={base}></div>
</Base>

<link rel="stylesheet" href={`${base}/pagefind/pagefind-ui.css`} />
<script is:inline>
  // Pagefind's index is generated post-build (see package.json "postbuild"),
  // so it only exists after `npm run build`, not in `astro dev`.
  // pagefind-ui.js is a classic script that defines the global PagefindUI
  // (it is not an ES module with exports), so it is loaded as a script tag.
  (function () {
    var el = document.getElementById("search");
    var base = el.getAttribute("data-base");
    var s = document.createElement("script");
    s.src = base + "/pagefind/pagefind-ui.js";
    s.onload = function () {
      var ui = new window.PagefindUI({
        element: "#search",
        showSubResults: true,
        showImages: false,
        // Kategorie (Orgel / Person / Literatur) vor dem Titel anzeigen
        processResult: function (result) {
          var k = result.meta && result.meta.kategorie;
          if (k) result.meta.title = k + " · " + result.meta.title;
          return result;
        },
      });
      // Suchfeld der Startseite übergibt ?q=...
      var q = new URLSearchParams(location.search).get("q");
      if (q) ui.triggerSearch(q);
    };
    document.head.appendChild(s);
  })();
</script>
