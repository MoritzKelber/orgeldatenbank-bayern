---
import Base from "../layouts/Base.astro";
import { getAllOrgans, getAllPersonen, getAllLiterature } from "../lib/data";

const organs = getAllOrgans();
const personen = getAllPersonen();
const literature = getAllLiterature();
const erhalten = organs.filter((o) => o.erhalten).length;
const base = import.meta.env.BASE_URL;
---
<Base title="Startseite" hero>
  <div slot="hero" class="hero" style={`background-image: linear-gradient(to bottom, rgba(11,37,69,0.95) 0%, rgba(11,37,69,0.75) 12%, rgba(11,37,69,0.3) 28%, rgba(11,37,69,0.1) 42%, rgba(11,37,69,0.88)), url(${base}/images/hero-st-anna-augsburg.jpg);`}>
    <div class="hero-inner">
      <h1>Orgeldatenbank Bayern</h1>
      <form class="hero-search" action={`${base}/suche/`} method="get" role="search">
        <input type="search" name="q" placeholder="Orte, Kirchen, Orgelbauer, Literatur durchsuchen …" aria-label="Volltextsuche" />
        <button type="submit">Suchen</button>
      </form>
      <a class="hero-credit" href="https://commons.wikimedia.org/wiki/File:St._Anna_(Augsburg)_Orgel.jpg" target="_blank" rel="noopener">
        Orgel St. Anna (Fuggerkapelle), Augsburg · Foto: Ricardalovesmonuments, CC BY-SA 4.0, via Wikimedia Commons
      </a>
    </div>
  </div>
  <p>
    Die Orgeldatenbank wurde von Michael Bernhard und der Gesellschaft für Bayerische
    Musikgeschichte e. V. (GfBM) herausgegeben. Die letzte Version 5 erschien im Jahr 2009.
    Aktuell wird die Orgeldatenbank im Rahmen des Digital Lab der GfBM erweitert und
    zukunftsfähig gemacht. Die Daten auf dieser Website sind vorläufig und teilweise unkorrigiert.
  </p>
  <ul class="stats">
    <li><strong>{organs.length.toLocaleString("de-DE")}</strong> erfasste Orgeln, davon <strong>{erhalten.toLocaleString("de-DE")}</strong> erhalten</li>
    <li><strong>{personen.length.toLocaleString("de-DE")}</strong> Einträge im Personenlexikon</li>
    <li><strong>{literature.length.toLocaleString("de-DE")}</strong> Literaturnachweise im Katalog</li>
  </ul>
  <nav class="cards">
    <a class="card" href={`${base}/orgeln/`}>
      <h2>Orgeln durchsuchen</h2>
      <p>Nach Ort, Landkreis, Regierungsbezirk, Erbauer und Baujahr filtern.</p>
    </a>
    <a class="card" href={`${base}/personen/`}>
      <h2>Personenlexikon</h2>
      <p>Einzeln erfasste Orgelbauer-Persönlichkeiten mit Lebensdaten und GND-Verknüpfung.</p>
    </a>
    <a class="card" href={`${base}/literatur/`}>
      <h2>Literaturverzeichnis</h2>
      <p>Quellen und Veröffentlichungen zur bayerischen Orgelgeschichte.</p>
    </a>
  </nav>
</Base>

<style>
  .hero {
    position: relative;
    min-height: min(34rem, 75vh);
    background-size: cover;
    background-position: center 28%;
    background-repeat: no-repeat;
    display: flex;
    align-items: flex-end;
  }
  .hero-inner {
    width: 100%;
    max-width: 920px;
    margin: 0 auto;
    padding: 6rem 1.25rem 3.5rem;
    color: #fff;
    position: relative;
  }
  .hero-search { display: flex; flex-wrap: wrap; gap: 0.5rem; max-width: 42rem; }
  .hero-search input {
    flex: 1 1 9rem;
    min-width: 0;
    padding: 0.8rem 1.1rem;
    font: inherit;
    font-size: 1.05rem;
    border: none;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.95);
    color: #15263a;
  }
  .hero-search input:focus { outline: 2px solid #8ec5ee; outline-offset: 2px; }
  .hero-search button {
    padding: 0.8rem 1.3rem;
    font: inherit;
    font-weight: 600;
    border: none;
    border-radius: 0.5rem;
    background: #2f6fb3;
    color: #fff;
    cursor: pointer;
  }
  .hero-search button:hover { background: #1d4e89; }
  .hero h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.8rem, 4.5vw, 2.6rem);
    color: #fff;
  }
  .hero-credit {
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    bottom: 0.6rem;
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    text-align: left;
  }
  .hero-credit:hover { color: #fff; text-decoration: underline; }
  @media (max-width: 600px) {
    .hero { min-height: 20rem; }
    .hero-credit { bottom: 0.4rem; font-size: 0.6rem; }
  }

  .stats { padding-left: 1.25rem; }
  .cards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-top: 2rem; }
  .card {
    display: block;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1rem;
    text-decoration: none;
    color: inherit;
  }
  .card:hover { border-color: var(--color-accent); }
  .card h2 { margin: 0 0 0.4rem; font-size: 1.05rem; }
  .card p { margin: 0; font-size: 0.9rem; opacity: 0.85; }
</style>
