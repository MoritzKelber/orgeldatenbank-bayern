---
import Base from "../../layouts/Base.astro";
import { getAllLiterature } from "../../lib/data";

const literature = [...getAllLiterature()].sort((a, b) => a.kurztitel.localeCompare(b.kurztitel, "de"));
const base = import.meta.env.BASE_URL;
---
<Base title="Literaturverzeichnis" description="Quellen und Veröffentlichungen zur bayerischen Orgelgeschichte.">
  <h1>Literaturverzeichnis</h1>
  <p>{literature.length} Katalogeinträge.</p>

  <input type="search" id="lit-search" class="search-bar" placeholder="Literatur durchsuchen, z.B. „Fischer“ …" />
  <p id="lit-count" class="count-line"></p>

  <div class="lit-grid" id="lit-grid">
    {literature.map((l) => {
      const searchText = [l.kurztitel, l.autor, l.titel].filter(Boolean).join(" ").toLowerCase();
      return (
        <a class="lit-card" href={`${base}/literatur/${l.slug}/`} data-name={searchText}>
          <span class="lit-kurztitel">{l.kurztitel}</span>
          {l.titel && <span class="lit-titel">{l.titel}</span>}
          {l.organ_ids.length > 0 && (
            <span class="lit-meta">
              <span class="meta-chip">{l.organ_ids.length} Orgel{l.organ_ids.length === 1 ? "" : "n"}</span>
            </span>
          )}
        </a>
      );
    })}
  </div>
</Base>

<style>
  .search-bar {
    display: block;
    width: 100%;
    max-width: 28rem;
    margin: 1rem 0 0.5rem;
    padding: 0.6rem 0.9rem;
    font: inherit;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
  }
  .search-bar:focus { outline: 2px solid var(--color-accent); outline-offset: 1px; }
  .count-line { font-size: 0.82rem; opacity: 0.7; margin: 0 0 1rem; }

  .lit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
  }
  .lit-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-surface);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .lit-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.08);
    transform: translateY(-1px);
  }
  .lit-card[hidden] { display: none; }
  .lit-kurztitel { font-weight: 600; }
  .lit-titel { font-size: 0.85rem; opacity: 0.8; }
  .lit-meta { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .meta-chip {
    font-size: 0.72rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    opacity: 0.85;
  }
</style>

<script>
  const input = document.getElementById("lit-search") as HTMLInputElement;
  const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>(".lit-card"));
  const countEl = document.getElementById("lit-count")!;
  const total = cards.length;

  function update() {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const match = !q || (card.dataset.name ?? "").includes(q);
      card.hidden = !match;
      if (match) visible++;
    }
    countEl.textContent = q ? `${visible} von ${total} Einträgen` : `${total} Einträge`;
  }

  input.addEventListener("input", update);
  update();
</script>
