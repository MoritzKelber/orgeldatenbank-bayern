---
import Base from "../../layouts/Base.astro";
import LiteraturZitat from "../../components/LiteraturZitat.astro";
import { getAllLiterature, getOrganById, getBuilderById } from "../../lib/data";

export function getStaticPaths() {
  return getAllLiterature().map((l) => ({ params: { slug: l.slug } }));
}

const { slug } = Astro.params;
const entry = getAllLiterature().find((l) => l.slug === slug)!;
const organs = entry.organ_ids.map((oid) => getOrganById(oid)).filter((o) => o !== undefined);
const lemmata = (entry.lemma_ids ?? [])
  .map((lid) => getBuilderById(lid))
  .filter((b) => b !== undefined && b.personen.length > 0);
const base = import.meta.env.BASE_URL;
const bms = entry.bms;
const bmsOk = bms?.status === "ok";
const gateway = entry.gateway_bayern;
const gatewayOk = gateway?.status === "ok";
const digi = entry.digitalisat?.status === "ok" ? entry.digitalisat.links : [];
const EBENE: Record<string, string> = {
  titel: "Digitalisat des Werks",
  sammelband: "Digitalisat des Sammelbands",
  band: "Digitalisat des Zeitschriftenjahrgangs",
  zeitschrift: "Digitalisat der Zeitschrift",
};
---
<Base title={entry.kurztitel}>
  <p><a href={`${base}/literatur/`}>&larr; zurück zum Literaturverzeichnis</a></p>
  <h1>{entry.kurztitel}</h1>
  <p class="zitat-block"><LiteraturZitat entry={entry} /></p>

  {digi.length > 0 && (
    <>
      <h2>Digitalisat</h2>
      <table class="facts">
        <tbody>
          {digi.map((d) => (
            <tr>
              <th>{EBENE[d.ebene] ?? "Digitalisat"}</th>
              <td>
                <a href={d.url} target="_blank" rel="noopener">{d.beschreibung} ↗</a>
                {" "}<span class="quelle-hinweis">({d.anbieter})</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {digi.some((d) => d.ebene === "band" || d.ebene === "zeitschrift") && (
        <p class="digi-hinweis">Der Beitrag selbst ist im verlinkten Jahrgang bzw. in der Zeitschrift an der angegebenen Seite zu finden.</p>
      )}
    </>
  )}

  <h2>Angaben aus der Orgeldatenbank</h2>
  <table class="facts">
    <tbody>
      {entry.autor && <tr><th>Autor</th><td>{entry.autor}</td></tr>}
      {entry.titel && <tr><th>Titel</th><td>{entry.titel}</td></tr>}
      {entry.biblio && <tr><th>Bibliografische Angabe (Quelltext)</th><td>{entry.biblio}</td></tr>}
      {entry.vorhanden && <tr><th>Vorhanden</th><td>{entry.vorhanden}</td></tr>}
    </tbody>
  </table>

  <h2>Bibliographie des Musikschrifttums (BMS)</h2>
  <table class="facts">
    <tbody>
      <tr>
        <th>BMS-ID</th>
        <td>
          {bmsOk ? <a href={bms!.url ?? undefined} target="_blank" rel="noopener">{bms!.ppn} ↗</a> : "–"}
        </td>
      </tr>
      {bmsOk && bms!.matched_titel && <tr><th>Titel in der BMS</th><td>{bms!.matched_titel}</td></tr>}
      {bmsOk && bms!.matched_autor && <tr><th>Autor in der BMS</th><td>{bms!.matched_autor}</td></tr>}
      {bmsOk && bms!.isbn.length > 0 && (
        <tr>
          <th>ISBN</th>
          <td>{bms!.isbn.join(" / ")} <span class="quelle-hinweis">(BMS)</span></td>
        </tr>
      )}
      {!bmsOk && bms?.status === "unsicher" && (
        <tr><th>Hinweis</th><td class="bms-hinweis" title={bms.grund ?? undefined}>unsichere Zuordnung, nicht übernommen ⓘ</td></tr>
      )}
    </tbody>
  </table>

  {gatewayOk && (
    <>
      <h2>Gateway Bayern</h2>
      <table class="facts">
        <tbody>
          <tr>
            <th>Titel im Verbundkatalog</th>
            <td>
              <a href={gateway!.url ?? undefined} target="_blank" rel="noopener">{gateway!.bv_nr} ↗</a>
              {" "}<span class="quelle-hinweis">{gateway!.via === "titel" ? "(über Titel, Autor und Jahr gefunden)" : `(über ISBN ${gateway!.isbn_used}, aus BMS)`}</span>
            </td>
          </tr>
        </tbody>
      </table>
    </>
  )}

  {entry.abstract && <p class="abstract">{entry.abstract}</p>}

  {entry.keywords.length > 0 && (
    <p class="keywords">
      {entry.keywords.map((k) => <span class="badge small">{k.stichwort}</span>)}
    </p>
  )}

  {lemmata.length > 0 && (
    <section>
      <h2>Zitiert bei {lemmata.length} Erbauer{lemmata.length === 1 ? "" : "n"}</h2>
      <ul>
        {lemmata.map((b) => (
          <li><a href={`${base}/personen/${b.id}-${b.personen[0]?.index ?? 1}/`}>{b.name}</a></li>
        ))}
      </ul>
    </section>
  )}

  {organs.length > 0 && (
    <section>
      <h2>Zitiert bei {organs.length} Orgel{organs.length === 1 ? "" : "n"}</h2>
      <ul>
        {organs.map((o) => (
          <li><a href={`${base}/orgeln/${o!.id}/`}>{[o!.kirche, o!.ort].filter(Boolean).join(", ")}</a></li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .zitat-block { font-size: 1.05rem; margin: 0.75rem 0 1.5rem; }
  .facts { margin: 1rem 0 2rem; }
  .facts th { width: 14rem; opacity: 0.7; font-weight: normal; vertical-align: top; }
  .bms-hinweis { color: #8a6500; cursor: help; }
  .quelle-hinweis { font-size: 0.75rem; opacity: 0.6; }
  .digi-hinweis { font-size: 0.85rem; opacity: 0.7; margin: -1.25rem 0 2rem; }
  .abstract { white-space: pre-line; }
  .keywords { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .badge.small { font-size: 0.7rem; padding: 0.1rem 0.5rem; }
</style>
