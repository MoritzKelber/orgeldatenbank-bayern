---
import Base from "../../layouts/Base.astro";
import { getAllBuilders } from "../../lib/data";

const builders = [...getAllBuilders()]
  .filter((b) => b.name)
  .sort((a, b) => a.name!.localeCompare(b.name!, "de"));
const base = import.meta.env.BASE_URL;
---
<Base title="Erbauer-Lexikon" description="Lexikon bayerischer und auswärtiger Orgelbauer.">
  <h1>Erbauer-Lexikon</h1>
  <p>
    {builders.length} Einträge. Dies ist ein eigenständiges biografisches Lexikon - nicht jeder in den
    Orgeldatensätzen genannte Erbauername hat hier einen eigenen Eintrag (siehe <a href={`${base}/ueber/`}>Über diese Seite</a>).
  </p>

  <input type="search" id="erbauer-search" class="search-bar" placeholder="Lexikon durchsuchen, z.B. „Steinmeyer“ …" />
  <p id="erbauer-count" class="count-line"></p>

  <div class="builder-grid" id="builder-grid">
    {builders.map((b) => {
      const gndCount = (b.personen ?? []).filter((p) => p.gnd?.status === "ok").length;
      return (
        <a class="builder-card" href={`${base}/erbauer/${b.id}/`} data-name={b.name!.toLowerCase()}>
          <span class="builder-name">{b.name}</span>
          <span class="builder-meta">
            {b.organ_ids.length > 0 && (
              <span class="meta-chip">{b.organ_ids.length} Orgel{b.organ_ids.length === 1 ? "" : "n"}</span>
            )}
            {gndCount > 0 && <span class="meta-chip chip-gnd">GND{gndCount > 1 ? ` ×${gndCount}` : ""}</span>}
          </span>
        </a>
      );
    })}
  </div>
</Base>

<style>
  .search-bar {
    display: block;
    width: 100%;
    max-width: 28rem;
    margin: 1rem 0 0.5rem;
    padding: 0.6rem 0.9rem;
    font: inherit;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
  }
  .search-bar:focus { outline: 2px solid var(--color-accent); outline-offset: 1px; }
  .count-line { font-size: 0.82rem; opacity: 0.7; margin: 0 0 1rem; }

  .builder-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.75rem;
  }
  .builder-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-surface);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .builder-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.08);
    transform: translateY(-1px);
  }
  .builder-card[hidden] { display: none; }
  .builder-name { font-weight: 600; }
  .builder-meta { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .meta-chip {
    font-size: 0.72rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    opacity: 0.85;
  }
  .chip-gnd {
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border-color: var(--color-accent);
    color: var(--color-accent);
    opacity: 1;
    font-weight: 600;
  }
</style>

<script>
  const input = document.getElementById("erbauer-search") as HTMLInputElement;
  const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>(".builder-card"));
  const countEl = document.getElementById("erbauer-count")!;
  const total = cards.length;

  function update() {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const match = !q || (card.dataset.name ?? "").includes(q);
      card.hidden = !match;
      if (match) visible++;
    }
    countEl.textContent = q ? `${visible} von ${total} Einträgen` : `${total} Einträge`;
  }

  input.addEventListener("input", update);
  update();
</script>
