---
import Base from "../../layouts/Base.astro";
import { getAllBuilders, getOrganById } from "../../lib/data";
import { BEZIEHUNG_LABELS, personDisplayName, personLebensdaten } from "../../lib/types";

export function getStaticPaths() {
  return getAllBuilders().map((b) => ({ params: { id: String(b.id) }, props: { id: b.id } }));
}

const { id } = Astro.props;
const builder = getAllBuilders().find((b) => b.id === id)!;
const organs = builder.organ_ids.map((oid) => getOrganById(oid)).filter((o) => o !== undefined);
const base = import.meta.env.BASE_URL;
const personen = builder.personen ?? [];
---
<Base title={builder.name ?? `Erbauer ${builder.id}`}>
  <p><a href={`${base}/erbauer/`}>&larr; zurück zum Lexikon</a></p>
  <h1>{builder.name}</h1>
  {personen.length > 1 && (
    <p class="hint">
      Dieses Lemma führt {personen.length} Personen namens {builder.name} (z.B. mehrere Generationen
      einer Werkstatt).
    </p>
  )}

  {personen.length > 0 && (
    <section>
      <h2>Personen</h2>
      <ul class="person-list">
        {personen.map((p) => (
          <li class:list={["person-card", `status-${p.gnd?.status ?? "keine"}`]}>
            <div class="person-main">
              <span class="person-name">{personDisplayName(p)}</span>
              {personLebensdaten(p) && <span class="lebensdaten">{personLebensdaten(p)}</span>}
              {p.beziehung && (
                <span class="relation-pill">{BEZIEHUNG_LABELS[p.beziehung.typ] ?? p.beziehung.typ} {p.beziehung.bezug_index}.</span>
              )}
            </div>
            {p.gnd?.status === "ok" ? (
              <a class="gnd-chip gnd-ok" href={p.gnd.url ?? undefined} target="_blank" rel="noopener">
                <span class="gnd-mark">GND</span> {p.gnd.preferred_name} <span class="gnd-arrow">↗</span>
              </a>
            ) : p.gnd?.status === "unsicher" ? (
              <span class="gnd-chip gnd-unsicher" title={p.gnd.grund ?? undefined}>
                <span class="gnd-mark">GND</span> unsichere Zuordnung <span class="gnd-help">?</span>
              </span>
            ) : p.gnd?.status === "nicht_zutreffend" ? null : (
              <span class="gnd-chip gnd-keine"><span class="gnd-mark">GND</span> kein Eintrag gefunden</span>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  {builder.biografie && <p class="biografie">{builder.biografie}</p>}

  {organs.length > 0 && (
    <section>
      <h2>Verlinkte Orgeln ({organs.length})</h2>
      <ul>
        {organs.map((o) => (
          <li><a href={`${base}/orgeln/${o!.id}/`}>{[o!.kirche, o!.ort].filter(Boolean).join(", ")}</a></li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .biografie { white-space: pre-line; }
  .hint { font-size: 0.9rem; opacity: 0.85; }

  .person-list { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .person-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-surface);
  }
  .person-card.status-ok { border-left-color: var(--color-accent); }
  .person-card.status-unsicher { border-left-color: #b8860b; }

  .person-main { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; }
  .person-name { font-weight: 700; font-size: 1.05rem; }
  .lebensdaten { font-size: 0.9rem; opacity: 0.75; }
  .relation-pill {
    font-size: 0.72rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    opacity: 0.85;
  }

  .gnd-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    padding: 0.25rem 0.6rem 0.25rem 0.3rem;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid var(--color-border);
    color: inherit;
  }
  .gnd-mark {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    padding: 0.08rem 0.4rem;
    border-radius: 999px;
  }
  .gnd-ok {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }
  .gnd-ok .gnd-mark { background: var(--color-accent); color: #fff; }
  .gnd-ok:hover { background: var(--color-accent); color: #fff; }
  .gnd-ok:hover .gnd-mark { background: #fff; color: var(--color-accent); }
  .gnd-arrow { opacity: 0.7; }

  .gnd-unsicher { color: #8a6500; cursor: help; background: color-mix(in srgb, #b8860b 10%, transparent); border-color: #b8860b; }
  .gnd-unsicher .gnd-mark { background: #b8860b; color: #fff; }
  .gnd-help {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.1rem; height: 1.1rem; border-radius: 50%;
    background: #b8860b; color: #fff; font-size: 0.68rem; font-weight: 700;
  }

  .gnd-keine { opacity: 0.65; }
  .gnd-keine .gnd-mark { background: var(--color-border); color: var(--color-text); }
</style>
