---
import Base from "../../layouts/Base.astro";
import DispoRenderer from "../../components/DispoRenderer.astro";
import { getAllOrgans, getOrganById, getBuilderById } from "../../lib/data";
import { RBZ_LABELS, formatJahr, formatCount } from "../../lib/types";

export function getStaticPaths() {
  return getAllOrgans().map((organ) => ({ params: { id: String(organ.id) }, props: { id: organ.id } }));
}

const { id } = Astro.props;
const organ = getOrganById(id)!;
// `bauer_person_id` (match/organ_person_match.py) is the direct, far more
// complete organ<->person link - only ever set for "sicher" matches, see
// that script's docstring. Falls back to the older, narrower
// lemma-resolves-to-exactly-one-person heuristic for the rare organ it
// doesn't cover (e.g. bauer_confidence "exact" but no forename to confirm).
const builder = organ.bauer_confidence === "exact" && organ.bauer_id != null ? getBuilderById(organ.bauer_id) : undefined;
const fallbackPersonId =
  builder && builder.personen.length === 1 ? `${builder.id}-${builder.personen[0].index}` : null;
const builderPersonId = organ.bauer_person_id ?? fallbackPersonId;
const builderPersonHref = builderPersonId ? `${import.meta.env.BASE_URL}/personen/${builderPersonId}/` : null;
const base = import.meta.env.BASE_URL;
const title = [organ.kirche, organ.ort].filter(Boolean).join(", ") || `Orgel ${organ.id}`;
const jahrAnzeige = formatJahr(organ.jahr);
---
<Base title={title}>
  <p><a href={`${base}/orgeln/`}>&larr; zurück zur Übersicht</a></p>
  <h1>{title}</h1>
  <p class="badges">
    <span class="badge">{organ.erhalten ? "Orgel erhalten" : "Orgel nicht erhalten"}</span>
    {organ.prospekt_erhalten && <span class="badge" title="Denkmalprospekt: das Gehäuse/die Schauseite ist denkmalgeschützt erhalten, unabhängig vom Erhaltungszustand des Pfeifenwerks">Prospekt erhalten</span>}
    {organ.denkmalorgel && <span class="badge">Denkmalorgel</span>}
    {organ.regierungsbezirk && <span class="badge">{RBZ_LABELS[organ.regierungsbezirk] ?? organ.regierungsbezirk}</span>}
  </p>

  <table class="facts">
    <tbody>
      <tr><th>ODB</th><td>{organ.id}</td></tr>
      {organ.kirche && (
        <tr>
          <th>Kirche</th>
          <td>
            {organ.kirche}
            {organ.kirche_gnd?.status === "ok" && (
              <a class="gnd-chip gnd-ok" href={organ.kirche_gnd.url ?? undefined} target="_blank" rel="noopener">
                <span class="gnd-mark">GND</span> {organ.kirche_gnd.preferred_name} <span class="gnd-arrow">↗</span>
              </a>
            )}
            {organ.kirche_gnd?.status === "unsicher" && (
              <span class="gnd-chip gnd-unsicher" title={organ.kirche_gnd.grund ?? undefined}>
                <span class="gnd-mark">GND</span> unsichere Zuordnung <span class="gnd-help">?</span>
              </span>
            )}
          </td>
        </tr>
      )}
      {(organ.adresse.zeile1 || organ.adresse.zeile2 || organ.adresse.plz || organ.adresse.ort) && (
        <tr>
          <th>Adresse</th>
          <td>
            {[organ.adresse.zeile1, organ.adresse.zeile2, [organ.adresse.plz, organ.adresse.ort].filter(Boolean).join(" ")]
              .filter(Boolean)
              .join(", ")}
          </td>
        </tr>
      )}
      {organ.landkreis && <tr><th>Landkreis</th><td>{organ.landkreis}</td></tr>}
      {jahrAnzeige && <tr><th>Baujahr</th><td>{jahrAnzeige}</td></tr>}
      {organ.bauer_name && (
        <tr>
          <th>Erbauer</th>
          <td>{builderPersonHref ? <a href={builderPersonHref}>{organ.bauer_name}</a> : organ.bauer_name}</td>
        </tr>
      )}
      {organ.manuale != null && <tr><th>Manuale</th><td>{formatCount(organ.manuale)}</td></tr>}
      {organ.register != null && <tr><th>Register</th><td>{formatCount(organ.register)}</td></tr>}
    </tbody>
  </table>

  {organ.dispo.raw && (
    <section>
      <h2>Disposition</h2>
      <DispoRenderer dispo={organ.dispo} />
    </section>
  )}

  {organ.bemerkung && (
    <section>
      <h2>Bemerkung</h2>
      <p>{organ.bemerkung}</p>
    </section>
  )}

  {organ.literatur.length > 0 && (
    <section>
      <h2>Literatur</h2>
      <ul class="literatur-list">
        {organ.literatur.map((citation) => (
          <li>
            {citation.slug ? <a href={`${base}/literatur/${citation.slug}/`}>{citation.lit}</a> : citation.lit}
            {citation.disp && <span class="badge small">Disposition</span>}
            {citation.abb && <span class="badge small">Abbildung</span>}
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .badges { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .facts { margin: 1rem 0; }
  .facts th { width: 9rem; opacity: 0.7; font-weight: normal; vertical-align: top; }
  .literatur-list { padding-left: 1.25rem; }
  .literatur-list li { margin-bottom: 0.3rem; }
  .badge.small { font-size: 0.65rem; margin-left: 0.4rem; padding: 0.05rem 0.4rem; }

  .gnd-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: 0.5rem;
    font-size: 0.78rem;
    padding: 0.2rem 0.55rem 0.2rem 0.3rem;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid var(--color-border);
    color: inherit;
  }
  .gnd-mark {
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    padding: 0.08rem 0.4rem;
    border-radius: 999px;
  }
  .gnd-ok {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }
  .gnd-ok .gnd-mark { background: var(--color-accent); color: #fff; }
  .gnd-ok:hover { background: var(--color-accent); color: #fff; }
  .gnd-ok:hover .gnd-mark { background: #fff; color: var(--color-accent); }
  .gnd-arrow { opacity: 0.7; }
  .gnd-unsicher { color: #8a6500; cursor: help; background: color-mix(in srgb, #b8860b 10%, transparent); border-color: #b8860b; }
  .gnd-unsicher .gnd-mark { background: #b8860b; color: #fff; }
  .gnd-help {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.1rem; height: 1.1rem; border-radius: 50%;
    background: #b8860b; color: #fff; font-size: 0.68rem; font-weight: 700;
  }
</style>
