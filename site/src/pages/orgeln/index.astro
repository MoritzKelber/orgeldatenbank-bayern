---
import Base from "../../layouts/Base.astro";
import { RBZ_LABELS } from "../../lib/types";
---
<Base title="Orgeln durchsuchen" description="Orgeln in Bayern nach Ort, Landkreis, Erbauer und Baujahr durchsuchen.">
  <h1>Orgeln durchsuchen</h1>
  <p id="status">Lade Daten …</p>

  <form id="filter-form" class="filter-form">
    <label>
      Suche (Ort, Kirche, Erbauer)
      <input type="search" id="f-text" placeholder="z.B. Augsburg" />
    </label>
    <label>
      Regierungsbezirk
      <select id="f-rbz">
        <option value="">Alle</option>
        {Object.entries(RBZ_LABELS).map(([code, label]) => <option value={code}>{label}</option>)}
      </select>
    </label>
    <label>
      Landkreis
      <select id="f-lkr"><option value="">Alle</option></select>
    </label>
    <label>
      Baujahr von
      <input type="number" id="f-jahr-von" placeholder="z.B. 1700" />
    </label>
    <label>
      Baujahr bis
      <input type="number" id="f-jahr-bis" placeholder="z.B. 1900" />
    </label>
    <label class="checkbox">
      <input type="checkbox" id="f-erhalten" /> nur erhaltene Orgeln
    </label>
    <label class="checkbox">
      <input type="checkbox" id="f-denkmal" /> nur Denkmalorgeln
    </label>
    <button type="button" id="f-reset" class="reset-button">Filter zurücksetzen</button>
  </form>

  <!-- Reserves space up front so the table/pagination popping in once the
       data has loaded doesn't shift the footer below (Lighthouse flagged
       this as a real Cumulative Layout Shift issue). -->
  <div class="results-area">
    <table id="results-table" hidden>
      <thead>
        <tr><th>Ort</th><th>Kirche</th><th>Landkreis</th><th>Erbauer</th><th>Baujahr</th><th>Reg.</th></tr>
      </thead>
      <tbody id="results-body"></tbody>
    </table>

    <nav id="pagination" class="pagination" hidden>
      <button type="button" id="p-prev">&larr; zurück</button>
      <span id="p-info"></span>
      <button type="button" id="p-next">weiter &rarr;</button>
    </nav>
  </div>
</Base>

<style>
  /* Festes Spaltenraster statt auto-fit: jedes Feld bekommt exakt dieselbe
     Breite, und alle Felder sind an der Unterkante der Zeile ausgerichtet
     (align-items: end), damit Eingaben, Auswahllisten, Checkboxen und der
     Button gleich groß und bündig erscheinen, egal wie viel Labeltext davor
     steht. */
  .filter-form {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 1.25rem 0 1.5rem;
    align-items: end;
  }
  @media (max-width: 760px) {
    .filter-form { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .filter-form { grid-template-columns: 1fr; }
  }
  .filter-form label {
    display: flex;
    flex-direction: column;
    font-size: 0.85rem;
    font-weight: 600;
    gap: 0.35rem;
  }
  .filter-form input, .filter-form select {
    height: 2.5rem;
    padding: 0 0.6rem;
    font: inherit;
    font-weight: normal;
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    background: var(--color-surface);
    color: var(--color-text);
  }
  .filter-form input:focus, .filter-form select:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  .filter-form label.checkbox {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
    height: 2.5rem;
    padding: 0 0.6rem;
    font-weight: normal;
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    background: var(--color-surface);
  }
  .filter-form .reset-button {
    height: 2.5rem;
    padding: 0 0.75rem;
    font: inherit;
    cursor: pointer;
    border: 1px solid var(--color-accent);
    border-radius: 0.35rem;
    background: var(--color-surface);
    color: var(--color-accent);
  }
  .filter-form .reset-button:hover { background: var(--color-accent); color: #fff; }
  .results-area { min-height: 40rem; }
  #results-table th { background: var(--color-header-bg); color: var(--color-header-text); }
  .pagination { display: flex; gap: 1rem; align-items: center; justify-content: center; margin-top: 1rem; }
  .pagination button {
    padding: 0.4rem 0.8rem;
    cursor: pointer;
    border: 1px solid var(--color-accent);
    border-radius: 0.35rem;
    background: var(--color-surface);
    color: var(--color-accent);
  }
  .pagination button:hover:not(:disabled) { background: var(--color-accent); color: #fff; }
  .pagination button:disabled { opacity: 0.4; cursor: default; }
</style>

<script>
  const BASE = import.meta.env.BASE_URL;
  const PAGE_SIZE = 50;

  // Matches the column order etl/src/pipeline.py writes organs-index.json
  // in. Rows are plain arrays, not objects - with ~32k rows, repeating
  // field-name strings per row would roughly double download size and
  // JSON.parse time for no benefit (Lighthouse flagged the resulting
  // Total Blocking Time before this change).
  const IDX = {
    id: 0, ort: 1, kirche: 2, gemeinde: 3, landkreis: 4, regierungsbezirk: 5,
    bauer_name: 6, manuale: 7, register: 8, erhalten: 9, denkmalorgel: 10,
    jahr: 11, jahr_anzeige: 12,
  } as const;

  type Row = [number, string | null, string | null, string | null, string | null, string | null, string | null, number | null, number | null, boolean, boolean, number | null, string | null];

  let all: Row[] = [];
  let filtered: Row[] = [];
  let page = 0;

  const statusEl = document.getElementById("status")!;
  const table = document.getElementById("results-table") as HTMLTableElement;
  const body = document.getElementById("results-body")!;
  const pagination = document.getElementById("pagination") as HTMLElement;
  const pInfo = document.getElementById("p-info")!;
  const pPrev = document.getElementById("p-prev") as HTMLButtonElement;
  const pNext = document.getElementById("p-next") as HTMLButtonElement;

  const fText = document.getElementById("f-text") as HTMLInputElement;
  const fRbz = document.getElementById("f-rbz") as HTMLSelectElement;
  const fLkr = document.getElementById("f-lkr") as HTMLSelectElement;
  const fJahrVon = document.getElementById("f-jahr-von") as HTMLInputElement;
  const fJahrBis = document.getElementById("f-jahr-bis") as HTMLInputElement;
  const fErhalten = document.getElementById("f-erhalten") as HTMLInputElement;
  const fDenkmal = document.getElementById("f-denkmal") as HTMLInputElement;
  const fReset = document.getElementById("f-reset") as HTMLButtonElement;

  function populateLandkreise() {
    const values = Array.from(new Set(all.map((r) => r[IDX.landkreis]).filter((v): v is string => !!v))).sort(
      (a, b) => a.localeCompare(b, "de"),
    );
    for (const lkr of values) {
      const opt = document.createElement("option");
      opt.value = lkr;
      opt.textContent = lkr;
      fLkr.appendChild(opt);
    }
  }

  function applyFilters() {
    const text = fText.value.trim().toLowerCase();
    const rbz = fRbz.value;
    const lkr = fLkr.value;
    const jahrVon = fJahrVon.value ? Number(fJahrVon.value) : null;
    const jahrBis = fJahrBis.value ? Number(fJahrBis.value) : null;
    const onlyErhalten = fErhalten.checked;
    const onlyDenkmal = fDenkmal.checked;

    filtered = all.filter((r) => {
      if (rbz && r[IDX.regierungsbezirk] !== rbz) return false;
      if (lkr && r[IDX.landkreis] !== lkr) return false;
      if (onlyErhalten && !r[IDX.erhalten]) return false;
      if (onlyDenkmal && !r[IDX.denkmalorgel]) return false;
      const jahr = r[IDX.jahr] as number | null;
      if (jahrVon != null && (jahr == null || jahr < jahrVon)) return false;
      if (jahrBis != null && (jahr == null || jahr > jahrBis)) return false;
      if (text) {
        const haystack = `${r[IDX.ort] ?? ""} ${r[IDX.kirche] ?? ""} ${r[IDX.bauer_name] ?? ""}`.toLowerCase();
        if (!haystack.includes(text)) return false;
      }
      return true;
    });
    page = 0;
    render();
  }

  function render() {
    const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
    page = Math.min(page, totalPages - 1);
    const start = page * PAGE_SIZE;
    const pageItems = filtered.slice(start, start + PAGE_SIZE);

    body.innerHTML = "";
    for (const r of pageItems) {
      const tr = document.createElement("tr");
      const link = `${BASE}/orgeln/${r[IDX.id]}/`;
      tr.innerHTML = `
        <td><a href="${link}">${r[IDX.ort] ?? "?"}</a></td>
        <td>${r[IDX.kirche] ?? ""}</td>
        <td>${r[IDX.landkreis] ?? ""}</td>
        <td>${r[IDX.bauer_name] ?? ""}</td>
        <td>${r[IDX.jahr_anzeige] ?? ""}</td>
        <td>${r[IDX.register] ?? ""}</td>
      `;
      body.appendChild(tr);
    }

    statusEl.textContent = `${filtered.length.toLocaleString("de-DE")} Orgeln gefunden (von ${all.length.toLocaleString("de-DE")} insgesamt)`;
    table.hidden = filtered.length === 0;
    pagination.hidden = filtered.length === 0;
    pInfo.textContent = `Seite ${page + 1} von ${totalPages}`;
    pPrev.disabled = page === 0;
    pNext.disabled = page >= totalPages - 1;
  }

  pPrev.addEventListener("click", () => { page--; render(); });
  pNext.addEventListener("click", () => { page++; render(); });
  for (const el of [fText, fRbz, fLkr, fJahrVon, fJahrBis, fErhalten, fDenkmal]) {
    el.addEventListener("input", applyFilters);
  }
  fReset.addEventListener("click", () => {
    fText.value = "";
    fRbz.value = "";
    fLkr.value = "";
    fJahrVon.value = "";
    fJahrBis.value = "";
    fErhalten.checked = false;
    fDenkmal.checked = false;
    applyFilters();
  });

  fetch(`${BASE}/data/organs-index.json`)
    .then((r) => r.json())
    .then((data: { fields: string[]; rows: Row[] }) => {
      all = data.rows;
      // Yield to the browser between these two passes over 32k rows
      // instead of doing both in the same long task - keeps the page
      // responsive to input while the initial filter/render runs.
      setTimeout(() => {
        populateLandkreise();
        setTimeout(applyFilters, 0);
      }, 0);
    })
    .catch(() => {
      statusEl.textContent = "Daten konnten nicht geladen werden.";
    });
</script>
