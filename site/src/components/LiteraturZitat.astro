---
// Ein Literatureintrag als Zitat nach den Richtlinien der Zeitschrift
// "Die Musikforschung" (Literaturverzeichnis-Form). Die ganze Logik steckt
// in lib/zitat.ts; hier wird nur gesetzt:
//   Autor, „Titel“, in: *Container* Rest.      (unselbständig)
//   Autor, *Titel*, Rest.                      (selbständig)
import { formatZitat, type Zitat } from "../lib/zitat";
import type { LiteraturEntry } from "../lib/types";

interface Props {
  entry: LiteraturEntry;
}
const { entry } = Astro.props;
const z: Zitat = formatZitat(entry);
const endsWithPunct = /[.!?…]$/.test(z.rest || z.container || z.titel);
// Zeitschrift: *Name* 38 (1981) ohne Komma; Sammelband/Monografie: Komma;
// eine Reihenangabe "(= …)" folgt dem Titel ohne Komma.
let sep = "";
if (z.rest) {
  if (z.art === "zeitschrift") sep = " ";
  else if (z.art === "unselbstaendig") sep = " ";
  else sep = z.rest.startsWith("(=") ? " " : ", ";
}
---
<span class="zitat">
  {z.autor && <strong>{z.autor}</strong>}
  {z.autor && ", "}
  {z.unselbstaendig ? (
    <span class="zitat-titel">„{z.titel}“</span>
  ) : (
    <em class="zitat-titel">{z.titel}</em>
  )}
  {z.unselbstaendig && z.container && (
    <>
      {", in: "}
      <em>{z.container}</em>
    </>
  )}
  {z.unselbstaendig && !z.container && z.rest && ", in:"}
  {sep}{z.rest}
  {!endsWithPunct && "."}
</span>
