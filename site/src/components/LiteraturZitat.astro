---
// Renders one literature entry as a citation styled after "Die
// Musikforschung"'s guidelines: Nachname, Vorname: „Titel", in: Zeitschrift
// Band (Jahr), S. x-y for a dependent work (journal article / chapter in an
// edited volume), but Nachname, Vorname: *Titel*, Ort Jahr - title set in
// italics, no quotation marks - for an independent publication (monograph).
// `biblio.inPrefix` (see lib/types.ts#formatBiblio) is exactly that signal:
// true when BIBLIO looks like a journal citation or already started with
// "In:", i.e. the work is contained in something else.
import { formatBiblio, type LiteraturEntry } from "../lib/types";

interface Props {
  entry: LiteraturEntry;
}
const { entry } = Astro.props;
const titel = entry.titel ?? entry.kurztitel;
const biblio = formatBiblio(entry.biblio);
const istUnselbstaendig = biblio?.inPrefix ?? false;
---
<span class="zitat">
  {entry.autor && <strong>{entry.autor}</strong>}
  {entry.autor && ": "}
  {istUnselbstaendig ? (
    <span class="zitat-titel">„{titel}“</span>
  ) : (
    <em class="zitat-titel">{titel}</em>
  )}
  {biblio && (
    <>
      {", "}
      {biblio.inPrefix && "in: "}
      {biblio.journal && <em>{biblio.journal}</em>}
      {biblio.journal && " "}
      {biblio.rest}
    </>
  )}
  {!/[.!?…]$/.test(((biblio?.rest ?? "") || (biblio?.journal ?? "") || titel).trim()) && "."}
</span>
