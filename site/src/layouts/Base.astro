---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Orgeldatenbank Bayern - historische Orgeln in Bayern recherchieren." } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Orgeldatenbank Bayern</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={`${base}/`}>Orgeldatenbank Bayern</a>
        <nav>
          {[
            ["orgeln", "Orgeln"],
            ["personen", "Personen"],
            ["literatur", "Literatur"],
            ["karte", "Karte"],
            ["suche", "Suche"],
            ["ueber", "Über"],
          ].map(([slug, label]) => (
            <a href={`${base}/${slug}/`} aria-current={Astro.url.pathname.includes(`/${slug}/`) ? "page" : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main data-pagefind-body>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p>Orgeldatenbank Bayern</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Farbschema an gfbm-online.de angelehnt (Marineblau/Himmelblau). */
  :root {
    --color-bg: #f7fafd;
    --color-surface: #ffffff;
    --color-text: #15263a;
    --color-accent: #1d4e89;
    --color-accent-hover: #2f6fb3;
    --color-border: #c8dcef;
    --color-header-bg: #0b2545;
    --color-header-text: #eef4fb;
    --color-header-accent: #8ec5ee;
    /* Durchgehend System-Sans-Stack, keine Serifenschrift. */
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Oxygen-Sans", Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --color-bg: #0e1824;
      --color-surface: #142238;
      --color-text: #e9f1fa;
      --color-accent: #8ec5ee;
      --color-accent-hover: #b9d3ec;
      --color-border: #22395a;
      --color-header-bg: #081a33;
      --color-header-text: #eef4fb;
      --color-header-accent: #8ec5ee;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.5;
  }
  a { color: var(--color-accent); }
  a:hover { color: var(--color-accent-hover); }
  button, input, select, textarea { font-family: inherit; }
  .header-inner {
    max-width: 920px;
    margin: 0 auto;
    background: var(--color-header-bg);
    border-bottom: 3px solid var(--color-accent-hover);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
  }
  .site-header .brand {
    font-weight: bold;
    font-size: 1.1rem;
    text-decoration: none;
    color: var(--color-header-text);
  }
  .site-header nav { display: flex; gap: 0.25rem; flex-wrap: wrap; }
  .site-header nav a {
    text-decoration: none;
    color: var(--color-header-text);
    padding: 0.4rem 0.7rem;
    border-radius: 0.3rem;
  }
  .site-header nav a:hover { background: var(--color-accent-hover); color: #fff; }
  .site-header nav a[aria-current="page"] { color: var(--color-header-accent); font-weight: bold; }
  main {
    max-width: 920px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 4rem;
  }
  .footer-inner {
    max-width: 920px;
    margin: 0 auto;
    background: var(--color-header-bg);
    color: var(--color-header-text);
    font-size: 0.85rem;
    padding: 1.5rem 1.25rem;
  }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid var(--color-border); }
  .badge {
    display: inline-block;
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
  }
</style>
